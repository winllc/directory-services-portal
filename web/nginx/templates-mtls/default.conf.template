# HTTPS with optional X.509 client certificates (select with
# NGINX_ENVSUBST_TEMPLATE_DIR=/etc/nginx/templates-mtls). nginx verifies the client certificate
# against /etc/nginx/tls/ca.pem and forwards it to the API in X-SSL-Client-Cert, which the API
# accepts with X509_SOURCE=header, together with the proxy secret (X509_PROXY_SECRET_FILE or
# X509_PROXY_SECRET, the same value as the API's). Mount server.pem, server.key and ca.pem into
# /etc/nginx/tls.

# Forward only certificates nginx verified, and only to the endpoints that use them (certificate
# sign-in and the auto sign-in check). Every other request gets an empty header, which keeps a
# multi-kilobyte certificate out of each API call.
map "$ssl_client_verify:$uri" $dsp_client_cert {
    "~^SUCCESS:/api/auth/(x509|me)$" $ssl_client_escaped_cert;
    default "";
}

server {
    listen 8080;
    server_name _;
    return 301 https://$host${HTTPS_PORT_SUFFIX}$request_uri;
}
server {
    listen 8443 ssl;
    server_name _;
    server_tokens off;

    ssl_certificate         /etc/nginx/tls/server.pem;
    ssl_certificate_key     /etc/nginx/tls/server.key;
    ssl_client_certificate  /etc/nginx/tls/ca.pem;
    # "optional": browsers without a certificate can still use password sign-in.
    ssl_verify_client       optional;
    ssl_verify_depth        3;
    ssl_protocols           TLSv1.2 TLSv1.3;
    root /usr/share/nginx/html;

    # Schema and entry imports can be large (IMPORT_MAX_BYTES, 5 MiB by default: raise both together).
    client_max_body_size 5m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # ENS baseline security headers, on the client's pages and (replacing the API's) on /api. The
    # CSP is only reported with ENS_CSP_REPORT_ONLY=true (see entrypoint.sh). The client has no
    # inline scripts.
    add_header ${DSP_CSP_HEADER} "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    # Resolve the API host at request time so the web container starts even if the API isn't
    # up yet, and follows it if its address changes.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    resolver_timeout 5s;

    location ^~ /api/ {
        set $api_upstream ${API_URL};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # nginx is the edge: overwrite (don't append) so clients can't spoof their address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The public host (PUBLIC_HOST), else the one the browser used; the port nginx listens on is internal.
        proxy_set_header X-Forwarded-Host "${DSP_FORWARDED_HOST}";
        # Only the headers above describe the request: drop the ones a client could add to steer
        # the API's idea of its own address (Spring prefers Forwarded over X-Forwarded-*).
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-Port "";
        proxy_read_timeout 120s;
        # The security headers come from this server block; drop the API's copies so each is sent once.
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Content-Security-Policy-Report-Only;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        # Proves to the API that the request came through this proxy (the X.509 proxy secret), in
        # place of any value a client sent; the API trusts the certificate header only with it.
        proxy_set_header X-DSP-Proxy-Secret "${DSP_PROXY_SECRET}";
        # The verified certificate, in the header the API reads (X509_HEADER, see entrypoint.sh).
        ${DSP_CERT_HEADERS_HTTPS}
    }

    # Hashed build assets never change.
    location ^~ /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # Other files (favicon, ...) are served as-is; missing ones are a real 404.
    location ~ \.[A-Za-z0-9]+$ {
        try_files $uri =404;
    }

    # Client-side routes (/d/staff, /admin/forms, ...) all load the app shell, which is never cached.
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
