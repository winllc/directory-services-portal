# Rendered at container start by web/nginx/entrypoint.sh (envsubst): ${API_URL} and
# ${NGINX_LOCAL_RESOLVERS} (taken from the container's /etc/resolv.conf).

# HSTS when a TLS-terminating proxy in front says the browser used HTTPS (browsers ignore the
# header on plain HTTP, so a client sending X-Forwarded-Proto itself gains nothing). Empty: none.
map $http_x_forwarded_proto $dsp_hsts {
    https   "max-age=31536000; includeSubDomains";
    default "";
}

# The scheme the browser used, for the API (redirect URIs of single sign-on, Secure cookies): https
# when a TLS-terminating proxy in front says so, else this server's own. Only "https" is taken
# from the header; a client claiming it over plain HTTP only gets cookies its browser won't send
# back.
map $http_x_forwarded_proto $dsp_forwarded_proto {
    https   https;
    default $scheme;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    # Schema imports can be large.
    client_max_body_size 5m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # ENS baseline security headers, on the client's pages and (replacing the API's) on /api. The
    # CSP is only reported with ENS_CSP_REPORT_ONLY=true (see entrypoint.sh). The client has no
    # inline scripts.
    add_header ${DSP_CSP_HEADER} "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
    add_header Strict-Transport-Security $dsp_hsts always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    # Resolve the API host at request time so the web container starts even if the API isn't
    # up yet, and follows it if its address changes.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    resolver_timeout 5s;

    location ^~ /api/ {
        set $api_upstream ${API_URL};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # nginx is the edge: overwrite (don't append) so clients can't spoof their address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $dsp_forwarded_proto;
        # The host (and port) the browser used; the port nginx listens on is internal.
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_read_timeout 120s;
        # The security headers come from this server block; drop the API's copies so each is sent once.
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Content-Security-Policy-Report-Only;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        # Proves to the API that the request came through this proxy (the X.509 proxy secret), in
        # place of any value a client sent.
        proxy_set_header X-DSP-Proxy-Secret "${DSP_PROXY_SECRET}";
        # Never let a client supply a certificate header (see templates-mtls for X.509 sign-in).
        # Which headers: X509_HEADER and X509_EDGE_TERMINATION, see entrypoint.sh.
        ${DSP_CERT_HEADERS_HTTP}
    }

    # Hashed build assets never change.
    location ^~ /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # Other files (favicon, ...) are served as-is; missing ones are a real 404.
    location ~ \.[A-Za-z0-9]+$ {
        try_files $uri =404;
    }

    # Client-side routes (/d/staff, /admin/forms, ...) all load the app shell, which is never cached.
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
