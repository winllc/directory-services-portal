# Rendered at container start by web/nginx/entrypoint.sh (envsubst): ${API_URL} and
# ${NGINX_LOCAL_RESOLVERS} (taken from the container's /etc/resolv.conf).
server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    # Schema imports can be large.
    client_max_body_size 5m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    # Resolve the API host at request time so the web container starts even if the API isn't
    # up yet, and follows it if its address changes.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location ^~ /api/ {
        set $api_upstream ${API_URL};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # nginx is the edge: overwrite (don't append) so clients can't spoof their address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The host (and port) the browser used; the port nginx listens on is internal.
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_read_timeout 120s;
        # Never let a client supply a certificate header (see templates-mtls for X.509 sign-in).
        proxy_set_header X-SSL-Client-Cert "";
    }

    # Hashed build assets never change.
    location ^~ /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # Other files (favicon, ...) are served as-is; missing ones are a real 404.
    location ~ \.[A-Za-z0-9]+$ {
        try_files $uri =404;
    }

    # Client-side routes (/d/staff, /admin/forms, ...) all load the app shell, which is never cached.
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
