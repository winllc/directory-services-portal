<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.winllc</groupId>
  <artifactId>directory-services-portal</artifactId>
  <version>0.1.0</version>
  <name>Directory Services Portal</name>
  <description>Spring Boot backend for the LDAP directory services portal</description>
  <licenses>
    <license>
      <name>LicenseRef-ENS-Commercial</name>
      <url>https://github.com/winllc/directory-services-portal/blob/main/LICENSE</url>
      <comments>Proprietary to ENS Solutions; use requires a license.</comments>
    </license>
  </licenses>

  <properties>
    <java.version>21</java.version>
    <unboundid.version>7.0.5</unboundid.version>
    <!-- Security fixes ahead of Spring Boot 4.1.1's managed versions (Trivy: CVE-2026-65182,
         CVE-2026-65905, CVE-2026-68525 in Tomcat 11.0.24; CVE-2026-89407, CVE-2026-89425,
         CVE-2026-68497, CVE-2026-91776, CVE-2026-91777 in Jackson 3.1.5). Remove once the Boot
         parent manages these versions or newer. -->
    <tomcat.version>11.0.27</tomcat.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <shedlock.version>7.10.1</shedlock.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Health probes (liveness, readiness) and the Prometheus endpoint on the management port. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>com.unboundid</groupId>
      <artifactId>unboundid-ldapsdk</artifactId>
      <version>${unboundid.version}</version>
    </dependency>

    <!-- Sign-in through an identity provider (DSP-03): OpenID Connect (authorization code with
         PKCE) and SAML 2.0. Both stay off until configured (portal.sso.*). -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-saml2-service-provider</artifactId>
    </dependency>

    <!-- The optional shared database for several API replicas (DSP-04): sessions (Spring Session
         JDBC), sign-in throttling, configuration, the audit store, jobs and cluster locks
         (ShedLock). Nothing here is used, and no connection is made, while DSP_DATABASE_URL is
         unset. The Boot starters are left out on purpose: their auto-configuration would demand a
         database. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.session</groupId>
      <artifactId>spring-session-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-core</artifactId>
      <version>${shedlock.version}</version>
    </dependency>
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-provider-jdbc-template</artifactId>
      <version>${shedlock.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The shared-database tests run against a real PostgreSQL (skipped without Docker). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Generates CA and client certificates for the X.509 authentication tests. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <version>1.86</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- OpenSAML, which Spring Security's SAML 2.0 support is built on, is published only to the
       Shibboleth project's repository (as Spring Security's own documentation sets up). -->
  <repositories>
    <repository>
      <id>shibboleth-releases</id>
      <url>https://build.shibboleth.net/maven/releases/</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <build>
    <finalName>directory-services-portal</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <!-- META-INF/build-info.properties: its build time is the release date that perpetual
               ENS licenses' maintenance is checked against. -->
          <execution>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
