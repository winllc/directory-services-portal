# Directory Services Portal @VERSION@ settings. Docker Compose reads this file for the compose
# files (first section) and passes it to the API (everything else). Apply changes with
#   ./portal.sh up
# Quote values that contain spaces or start with "#".

# --- Deployment ---------------------------------------------------------------
# Which compose files to use (":" separated):
#   docker-compose.publish.yml   plain HTTP on WEB_PORT (put a TLS proxy in front)
#   docker-compose.mtls.yml      HTTPS on HTTPS_PORT, optional X.509 sign-in (needs ./certs)
#   docker-compose.openldap.yml  demo OpenLDAP server (demo only)
# With docker-compose.yml alone nothing is published; attach your own proxy to the network.
COMPOSE_FILE=@COMPOSE_FILE@
COMPOSE_PROJECT_NAME=directory-services-portal
API_IMAGE=@API_IMAGE@
WEB_IMAGE=@WEB_IMAGE@
OPENLDAP_IMAGE=@OPENLDAP_IMAGE@
# Host address and ports to publish on.
WEB_BIND=0.0.0.0
WEB_PORT=@WEB_PORT@
HTTPS_PORT=@HTTPS_PORT@
# How the HTTPS port appears in redirect URLs: ":8443", or empty when HTTPS_PORT is 443.
HTTPS_PORT_SUFFIX=@HTTPS_PORT_SUFFIX@
# Memory limits of the containers (the API's heap is 75% of its limit, JAVA_OPTS).
API_MEMORY_LIMIT=1536m
WEB_MEMORY_LIMIT=256m
# ENS Solutions license: kept in the ens-license volume (/var/lib/ens/directory-portal in the api
# container, with this installation's id). Without a license only sign-in and the license screen
# work. Install it on the license screen (Administration > License), or with
#   ./portal.sh license /path/to/license.lic
# install.sh and upgrade.sh copy ./license/license.lic into an empty volume. The image sets
# ENS_LICENSE_FILE and ENS_LICENSE_STATE_DIR; don't change them.

# The license itself, as an alternative to license/license.lic or an upload on the license
# screen: the token between the license file's BEGIN and END lines, or the whole file
# base64-encoded (base64 -w0 license.lic). It is installed at start if no license is installed
# yet, or if it is a newer revision of the installed one; otherwise the installed license is
# kept. Leave it empty to supply the license another way.
ENS_LICENSE=

# --- Directory connection -------------------------------------------------------
# "ldap" connects to LDAP_URL; "memory" runs the built-in demo directory (no LDAP server needed).
DIRECTORY_MODE=ldap
LDAP_URL=ldaps://ldap.example.com:636
LDAP_STARTTLS=false
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_TIMEOUT_MS=10000
LDAP_POOL_SIZE=10
# Service account used for all directory operations (the portal enforces its own permissions).
LDAP_BIND_DN=cn=portal,ou=system,dc=example,dc=com
# Its password, or LDAP_BIND_PASSWORD_FILE: a file in the container holding it (read instead).
LDAP_BIND_PASSWORD=change-me
LDAP_BASE_DN=dc=example,dc=com

# --- Users & groups -------------------------------------------------------------
LDAP_USER_SEARCH_BASE=ou=people,dc=example,dc=com
# {{username}} is replaced with the (escaped) login name.
LDAP_USER_FILTER=(&(objectClass=inetOrgPerson)(uid={{username}}))
LDAP_USERNAME_ATTRIBUTE=uid
LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=com
LDAP_GROUP_FILTER=(|(member={{dn}})(uniqueMember={{dn}}))
# Portal administrators. Separate multiple values with ";" (DNs contain commas).
ADMIN_USERS=
ADMIN_GROUPS=cn=directory-admins,ou=groups,dc=example,dc=com

# --- Server ---------------------------------------------------------------------
# Sessions (DISA STIG): the idle timeout (30m, 1h, ...), a shorter one for administrators (empty:
# the same; STIG suggests 15m), how long a session may last after sign-in whatever its activity,
# and concurrent sessions per user (0: no limit; over it the oldest ends; STIG suggests 3).
# Expiry is audited as auth.session-expired. SESSION_TTL_MINUTES, the older name of the idle
# timeout (in minutes), still works when ENS_SESSION_IDLE_TIMEOUT is not set.
ENS_SESSION_IDLE_TIMEOUT=30m
ENS_SESSION_ADMIN_IDLE_TIMEOUT=
ENS_SESSION_ABSOLUTE_TIMEOUT=12h
ENS_SESSION_MAX_PER_USER=0
# Integration API (/api/v1) and API tokens: requests per minute per token (per API instance) and
# the longest lifetime an administrator may give a token.
API_RATE_LIMIT_PER_MINUTE=120
API_TOKEN_MAX_DAYS=365
API_FAILED_TOKEN_LIMIT_PER_MINUTE=30
# Outbound webhooks. WEBHOOK_ALLOWED_HOSTS: host names (or *.example.com), ";"-separated, whose
# webhooks may reach private, loopback or link-local addresses (cloud metadata addresses never).
WEBHOOKS_ENABLED=true
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_SEND_TIMEOUT=20s
# How long one delivery run starts attempts for (a run ends within this plus WEBHOOK_SEND_TIMEOUT).
WEBHOOK_RUN_BUDGET=40s
# Entry export and import limits. Raise MAX_BODY_SIZE (the web tier's upload limit, e.g. 10m)
# with IMPORT_MAX_BYTES.
EXPORT_MAX_ENTRIES=10000
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=5000
BULK_MAX_MEMBERS=5000
MAX_BODY_SIZE=5m
# How often a signed-in user's groups and administrator status are read again from the directory
# (0: only at sign-in).
GROUP_REFRESH_INTERVAL=5m
# Failed password sign-ins for one user name from one address before further attempts are
# refused, and the window they are counted in (STIG suggests 3 in 15m).
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_WINDOW=15m
# Mark the session cookie Secure: "true" whenever browsers reach the portal over HTTPS (set
# automatically with the mTLS file). COOKIE_SECURE, its older name, still works.
ENS_COOKIE_SECURE=@COOKIE_SECURE@
# "true" sends Content-Security-Policy-Report-Only instead of Content-Security-Policy (web tier
# and API): an escape hatch for a page the policy breaks; report it and turn this off again.
ENS_CSP_REPORT_ONLY=false
# Seed example forms, directories, dashboards and analyses into an empty configuration.
SEED_DEMO_CONFIG=false
# Optional text on the login page (help-desk contact, ...).
LOGIN_HINT=
# DoD notice-and-consent banner (DISA STIG), shown before sign-in: no sign-in of any kind succeeds
# until the browser session has acknowledged it ("I agree"; audited as auth.consent-acknowledged).
# Empty title and text: the standard DoD wording. For your own text with several paragraphs, put
# it in a file the API can read (blank lines separate paragraphs, lines starting with "- " are list
# items) and set ENS_CONSENT_BANNER_FILE (it wins over ENS_CONSENT_BANNER_TEXT).
ENS_CONSENT_BANNER_ENABLED=false
ENS_CONSENT_BANNER_TITLE=
ENS_CONSENT_BANNER_TEXT=
ENS_CONSENT_BANNER_FILE=
# Optional fixed banner at the top and bottom of every page (off while BANNER_TEXT is empty).
BANNER_TEXT=
BANNER_FOREGROUND="#ffffff"
BANNER_BACKGROUND="#007a33"

# --- Audit log ------------------------------------------------------------------
# The audit store: hash-chained ens-audit/1 JSONL files, one per month. Empty: /data/audit inside
# the portal-data volume. (AUDIT_MEMORY_EVENTS is accepted but no longer used.)
AUDIT_DIR=
AUDIT_MEMORY_EVENTS=10000
# Each event as one raw JSON line on stdout (`./portal.sh logs api`, Docker logging drivers).
ENS_AUDIT_STDOUT=true
# Also write a rolling file (daily or at 100 MB), e.g. for the Splunk Universal Forwarder. Use a
# path under /var/log/ens (the ens-audit volume). Empty: off.
#ENS_AUDIT_FILE=/var/log/ens/directory-portal/audit.jsonl
ENS_AUDIT_FILE=
# Days of rolled files to keep.
ENS_AUDIT_FILE_KEEP=30
# Days of audit history to keep; 0 keeps everything. Only events every enabled output has
# delivered are pruned (daily), never the newest.
ENS_AUDIT_RETENTION_DAYS=0
# Splunk HTTP Event Collector, e.g. https://splunk.example:8088 (empty: off). Give the token here
# or in a file mounted into the container (ENS_AUDIT_SPLUNK_TOKEN_FILE).
ENS_AUDIT_SPLUNK_URL=
ENS_AUDIT_SPLUNK_TOKEN=
ENS_AUDIT_SPLUNK_TOKEN_FILE=
ENS_AUDIT_SPLUNK_INDEX=
ENS_AUDIT_SPLUNK_SOURCETYPE=ens:audit
# true skips the HEC certificate check: test setups only (a warning is logged at startup).
ENS_AUDIT_SPLUNK_INSECURE=false
# Syslog (RFC 5424, octet-counted over tcp/tls), e.g. siem.example (empty: off).
ENS_AUDIT_SYSLOG_HOST=
# Default 514 (udp, tcp) or 6514 (tls).
ENS_AUDIT_SYSLOG_PORT=
# udp, tcp or tls.
ENS_AUDIT_SYSLOG_PROTOCOL=tcp
ENS_AUDIT_SYSLOG_FACILITY=local0

# --- Metrics, analysis and background tasks -------------------------------------
METRICS_MAX_ENTRIES=100000
METRICS_CACHE_SECONDS=60
METRICS_WAIT_MILLIS=2000
ANALYSIS_MAX_ISSUES=50000
JOBS_METRICS_THREADS=4
JOBS_ANALYSIS_THREADS=2
JOBS_MAX_ACTIVE_PER_USER=5
JOBS_RETAIN_MINUTES=1440

# --- X.509 client-certificate sign-in (with docker-compose.mtls.yml) -----------
PASSWORD_LOGIN_ENABLED=true
X509_ENABLED=false
# The secret the web proxy sends to the API with every request (X-DSP-Proxy-Secret): the API
# accepts a forwarded client certificate only with it. Generated by install.sh (and by
# upgrade.sh when missing); keep it secret. To change it, set a new value (at least 32
# characters, e.g. openssl rand -hex 32) and run ./portal.sh up.
X509_PROXY_SECRET=
# Revocation checking of client certificates at sign-in (DISA STIG requires it; the API warns at
# startup while it is off): off, ocsp, crl or ocsp-then-crl, checked against certs/ca.pem. Empty
# is ocsp-then-crl, soft-fail: a certificate found revoked is refused, and one no OCSP responder
# or CRL answers for signs in with a warning in the API log.
# X509_CHECK_REVOCATION=true, the older setting, means ocsp-then-crl failing closed.
ENS_X509_REVOCATION=
# Ask this OCSP responder instead of the one in each certificate (e.g. a local OCSP relay).
ENS_X509_OCSP_RESPONDER_URL=
# A directory of CRL files (DER or PEM) the API can read, e.g. on an air-gapped network; read again
# when they change. With it set, CRL distribution points are not fetched.
ENS_X509_CRL_DIR=
# closed: refuse when the status can't be determined, as DISA STIG expects; open: allow, and log
# a warning. Empty: open while ENS_X509_REVOCATION is empty, closed once it is set.
ENS_X509_REVOCATION_FAIL=
# How long a good or revoked answer is kept, per certificate.
ENS_X509_REVOCATION_CACHE=10m
# Only certificates from these issuers (DNs separated by ";"), even if another trusted CA chains.
ENS_X509_ALLOWED_ISSUERS=
X509_CHECK_REVOCATION=false
# "filter" (search with X509_USER_FILTER) or "subject-dn" (the subject DN is the entry DN).
X509_MAPPING=filter
# Placeholders (filter-escaped), as {{name}} or {name}: cn, uid, email, upn, edipi (DoD EDIPI, from
# a UPN 1234567890@mil or a CN LAST.FIRST.MI.1234567890), uuid (from a SAN URI urn:uuid:...),
# subject, serial. E.g. (&(objectClass=user)(employeeID={edipi}))
X509_USER_FILTER=(&(objectClass=inetOrgPerson)(uid={{cn}}))
X509_REQUIRE_CERTIFICATE_MATCH=false
X509_AUTO_LOGIN=false

# --- Single sign-on (see README, Single sign-on) --------------------------------
# Off until configured; password and certificate sign-in are unaffected. The asserted identity
# ({{value}}) must match exactly one directory entry; groups and administrator rights come from
# the directory. Provider groups grant administrator only when listed in *_ADMIN_GROUPS (";").
# The portal must be reached over HTTPS (ENS_COOKIE_SECURE=true behind a TLS proxy) for SAML.
# The address users open the portal at (https://portal.example.com) and its host[:port] for the
# web proxy: redirect URIs and the SAML entity id are built from it, not from the request's Host.
# Required for SAML (or SSO_SAML_ENTITY_ID); recommended for OIDC.
PORTAL_PUBLIC_URL=
PUBLIC_HOST=
# A session whose administrator rights come only from the provider's groups ends after this.
SSO_IDP_ADMIN_SESSION_LIFETIME=1h
# OpenID Connect: redirect URI https://<portal>/api/auth/sso/callback/oidc
SSO_OIDC_ISSUER_URI=
SSO_OIDC_CLIENT_ID=
# Prefer SSO_OIDC_CLIENT_SECRET_FILE (a file the API container can read, e.g. under /data).
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_CLIENT_SECRET_FILE=
SSO_OIDC_SCOPES=openid profile email
# Prefer an immutable claim held in the directory (README); "email" needs email_verified=true.
SSO_OIDC_USERNAME_CLAIM=preferred_username
SSO_OIDC_USER_FILTER=(&(objectClass=inetOrgPerson)(uid={{value}}))
SSO_OIDC_GROUPS_CLAIM=groups
SSO_OIDC_ADMIN_GROUPS=
SSO_OIDC_LABEL=
# SAML 2.0: the IdP's metadata (https:// URL or a file). This SP: entity id and metadata
# https://<portal>/api/auth/sso/saml/metadata, ACS https://<portal>/api/auth/sso/saml/acs/saml.
SSO_SAML_METADATA=
SSO_SAML_ENTITY_ID=
# Empty: the NameID.
SSO_SAML_USERNAME_ATTRIBUTE=
SSO_SAML_USER_FILTER=(&(objectClass=inetOrgPerson)(uid={{value}}))
SSO_SAML_GROUPS_ATTRIBUTE=
SSO_SAML_ADMIN_GROUPS=
SSO_SAML_LABEL=
SSO_SAML_CLOCK_SKEW=2m

# --- Shared database (optional; see README, High availability) --------------------
# PostgreSQL for several API instances behind one load balancer. Unset: everything stays in the
# data volume and memory, one instance. The first start with it imports the data volume.
DSP_DATABASE_URL=
DSP_DATABASE_USERNAME=
DSP_DATABASE_PASSWORD=
DSP_DATABASE_PASSWORD_FILE=
# With the database the license state (installation id, license) moves into it: the first start
# imports it from the license volume. An upgraded database with no id to import refuses to start
# rather than make a new id; true accepts a new id (only for an installation never licensed).
ENS_LICENSE_ALLOW_NEW_INSTALLATION_ID=false

# --- Logs and monitoring -----------------------------------------------------------
# Log lines as JSON (Elastic Common Schema) instead of text; audit events on stdout are
# ens-audit/1 JSON lines either way.
#LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs
# A management port for Prometheus (/actuator/prometheus) and the health probes
# (/actuator/health/liveness, /readiness), without sign-in. Unset: no Prometheus endpoint; the
# probes are /livez and /readyz on port 3001. Never expose it to users: Docker publishes it only
# if a compose override says so (bind it to 127.0.0.1); the native package listens on 127.0.0.1.
#MANAGEMENT_SERVER_PORT=9090

# --- JVM ------------------------------------------------------------------------
# Extra JVM options for the API, e.g. -Xmx2g or a trust store for LDAPS:
#   -Djavax.net.ssl.trustStore=/data/truststore.p12 -Djavax.net.ssl.trustStorePassword=...
JAVA_TOOL_OPTIONS=
