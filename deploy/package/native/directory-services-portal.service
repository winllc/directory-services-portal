[Unit]
Description=Directory Services Portal API @VERSION@
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dsp
Group=dsp
EnvironmentFile=/etc/directory-services-portal/portal.env
WorkingDirectory=/var/lib/directory-services-portal
ExecStart=@JAVA@ -XX:MaxRAMPercentage=75.0 -jar /opt/directory-services-portal/api/directory-services-portal.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

# The ENS license: written by the license screen, with the installation id (also set in portal.env).
Environment=ENS_LICENSE_STATE_DIR=/var/lib/ens/directory-portal
Environment=ENS_LICENSE_FILE=/var/lib/ens/directory-portal/license.lic

# The optional audit file output (ENS_AUDIT_FILE=/var/log/ens/directory-portal/audit.jsonl in
# portal.env): systemd creates this directory, owned by the service user, and makes it writable.
LogsDirectory=ens/directory-portal

# Hardening: the API only needs to write its data, license and audit log directories.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/directory-services-portal /var/lib/ens/directory-portal
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
