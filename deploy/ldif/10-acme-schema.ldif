# Example non-standard schema loaded into OpenLDAP (cn=config).
dn: cn=acme,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: acme
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.3 NAME 'acmeSkill' DESC 'Professional skills' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{64} )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.4 NAME 'acmeOfficeLocation' DESC 'Office / campus' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{64} SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.2.1 NAME 'acmeDeviceSerial' DESC 'Hardware serial number' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{64} SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.2.2 NAME 'acmeDeviceType' DESC 'Laptop, phone, tablet...' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{32} SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.2.3 NAME 'acmeAssignedTo' DESC 'Person the device is assigned to' EQUALITY distinguishedNameMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 SINGLE-VALUE )
olcObjectClasses: ( 1.3.6.1.4.1.99999.10.1 NAME 'acmePerson' DESC 'ACME employee extensions' SUP top AUXILIARY MAY ( acmeSkill $ acmeOfficeLocation ) )
olcObjectClasses: ( 1.3.6.1.4.1.99999.10.2 NAME 'acmeDevice' DESC 'ACME managed hardware' SUP top STRUCTURAL MUST ( cn $ acmeDeviceSerial ) MAY ( acmeDeviceType $ acmeAssignedTo $ description ) )
