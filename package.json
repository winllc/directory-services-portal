{
  "name": "directory-services-portal",
  "private": true,
  "license": "LicenseRef-ENS-Commercial",
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev -w web\"",
    "dev:api": "cd backend && DEMO_MODE=${DEMO_MODE:-true} ENS_LICENSE_STATE_DIR=${ENS_LICENSE_STATE_DIR:-data/ens-license} ENS_LICENSE_FILE=${ENS_LICENSE_FILE:-data/ens-license/license.lic} ./mvnw -q spring-boot:run",
    "build": "npm run build -w web && npm run build:api",
    "build:api": "cd backend && ./mvnw -q -B clean package -DskipTests",
    "start": "concurrently -k -n api,web -c blue,green \"npm:start:api\" \"npm run preview -w web\"",
    "start:api": "DEMO_MODE=${DEMO_MODE:-true} ENS_LICENSE_STATE_DIR=${ENS_LICENSE_STATE_DIR:-data/ens-license} ENS_LICENSE_FILE=${ENS_LICENSE_FILE:-data/ens-license/license.lic} java -jar backend/target/directory-services-portal.jar",
    "test": "cd backend && ./mvnw -q -B test && cd .. && npm test -w web",
    "package": "scripts/package.sh",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
